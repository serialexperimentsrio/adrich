# Copy to .env.local for local development, and set the same variables on your host (e.g. Vercel).

# Required: Resend API key used to email contact/proposal form submissions.
RESEND_API_KEY=

# Optional: where submissions are delivered. Defaults to the email in data/site.ts.
CONTACT_TO_EMAIL=

# Optional: sender address. Must be on a domain verified in Resend (e.g. website@adrich.com.bd).
# Defaults to Resend's test sender "onboarding@resend.dev", which can only deliver to the
# email address that owns the Resend account.
RESEND_FROM_EMAIL=
